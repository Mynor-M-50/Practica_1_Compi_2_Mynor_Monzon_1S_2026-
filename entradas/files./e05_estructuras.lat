##
    Errores esperados: SEMANTICOS de estructuras
##
VARIABILES>

## Atributo repetido en la definicion ##
structura Mala {
    esto campo : textum;
    esto campo : numerus
} finis;

structura Persona {
    esto nombre : textum;
    esto edad : numerus;
    esto activo : bool
} finis;

## Falta inicializar atributos ##
esto incompleta : Persona {
    nombre: "Solo el nombre"
}

## Atributo que no existe en la definicion ##
esto sobrante : Persona {
    nombre: "X",
    edad: 20,
    activo: verum,
    inventado: "no existe"
}

## Atributo inicializado dos veces ##
esto duplicada : Persona {
    nombre: "A",
    nombre: "B",
    edad: 20,
    activo: verum
}

## Tipo incorrecto en un atributo ##
esto tipoMalo : Persona {
    nombre: 123,
    edad: "veinte",
    activo: 5
}

## Estructura que no existe ##
esto inexistente : NoDefinida {
    algo: 1
}

esto buena : Persona {
    nombre: "Valida",
    edad: 30,
    activo: verum
}

MAIOR>

## Atributo que no existe, en lectura ##
>> buena.noExiste;

## Acceso con punto sobre algo que no es estructura ##
esto simple : numerus 5;
>> simple.campo;

## Imprimir la estructura completa en vez de un atributo ##
>> buena;

FINIS;
