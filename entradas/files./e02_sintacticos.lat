##
    Errores esperados: SINTACTICOS
    Sirve para comprobar que el modo panico reporta varios errores
    en una sola pasada, en vez de detenerse en el primero
##
VARIABILES>
esto sinTipo : ;
esto faltaDosPuntos numerus 10;
esto valido : numerus 20;
esto operadorSuelto : numerus 5 + ;

MAIOR>
si (valido > ) {
    >> "condicion incompleta";
} finis;

dum {
    >> "falta condicion";
} finis;

>> ;

FINIS;
