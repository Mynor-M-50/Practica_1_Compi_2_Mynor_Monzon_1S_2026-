##
    Errores esperados: SEMANTICOS de funciones y retornos
##
VARIABILES>
esto valor : numerus 10;

MUNERA>

## Funcion ratio que nunca retorna ##
ratio numerus sinRetorno(esto x : numerus) {
    >> "no retorna nada";
} finis;

## Tipo de retorno que no coincide con el declarado ##
ratio numerus retornoMalo() {
    reddere "esto es texto";
} finis;

## Camino sin retorno: falta la rama aliter final ##
ratio numerus retornoParcial(esto x : numerus) {
    si (x > 0) {
        reddere 1;
    } finis;
} finis;

## Codigo despues de un reddere: inalcanzable ##
ratio numerus inalcanzable() {
    reddere 1;
    >> "nunca se ejecuta";
    esto perdida : numerus 5;
} finis;

## Funcion actio que intenta retornar un valor ##
actio noDebeRetornar() {
    reddere 5;
} finis;

## Parametro repetido ##
ratio numerus parametroRepetido(esto a : numerus, esto a : numerus) {
    reddere a;
} finis;

## Tipo de retorno que es una estructura inexistente ##
ratio NoExiste retornoInexistente() {
    reddere 1;
} finis;

## Parametro de tipo inexistente ##
actio parametroInexistente(esto p : TampocoExiste) {
    >> "nada";
} finis;

ratio numerus buena(esto a : numerus, esto b : numerus) {
    reddere a + b;
} finis;

MAIOR>

## Funcion no declarada ##
>> noDeclarada(1, 2);

## Cantidad de argumentos incorrecta ##
>> buena(1);
>> buena(1, 2, 3);

## Tipo de argumento incorrecto ##
>> buena("uno", "dos");

## Usar el retorno de una funcion actio como valor ##
esto sinValor : numerus noDebeRetornar();

## reddere fuera de una funcion ##
reddere valor;

FINIS;
