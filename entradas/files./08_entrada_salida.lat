##
    Prueba: funciones especiales de entrada y salida
    El foro confirmo que pueden ir en cualquier parte del codigo
##
VARIABILES>
esto nombre : textum "";
esto edad : numerus 0;
esto activo : bool falsus;
series datos[3] : numerus {0, 0, 0};

structura Registro {
    esto clave : textum
} finis;

esto registro : Registro { clave: "" }

MUNERA>

## Impresion y lectura dentro de una funcion ##
actio pedirDatos() {
    >> "Ingresa tu nombre";
    nombre <<
    >> "Bienvenido " >> nombre;
} finis;

MAIOR>

## Impresion de un solo valor ##
>> "Hola mundo";

## Impresion encadenada de varios valores ##
>> "Nombre: " >> nombre >> " Edad: " >> edad;

## Impresion de expresiones ##
>> "Suma: " >> edad + 10;
>> "Comparacion: " >> edad > 18;

## Lectura en variable simple ##
nombre <<
edad <<

## Lectura en elemento de arreglo ##
datos[0] <<

## Lectura en atributo de estructura ##
registro.clave <<

## Lectura sin destino, el valor se descarta ##
<<

## Entrada y salida dentro de un condicional ##
si (edad >= 18) {
    >> "Mayor de edad";
    activo = verum;
} aliter {
    >> "Menor de edad";
    edad <<
} finis;

## Entrada y salida dentro de un ciclo ##
per (esto i : numerus 0; i < 3; i++) {
    >> "Iteracion " >> i;
    datos[i] <<
} finis;

## Llamada a la funcion que tambien imprime y lee ##
pedirDatos();

FINIS;
