##
    Prueba: todos los tipos primitivos y las dos formas de booleano
##
VARIABILES>

## Tipos con valor inicial ##
esto entero : numerus 42;
esto decimal : decimalis 9.81;
esto texto : textum "Codex Latinus";
esto letra : littera 'a';

## Booleano tipado, forma nueva confirmada en el foro ##
esto activo : bool verum;
esto inactivo : bool falsus;

## Booleano sin tipo explicito, forma especial que se conserva ##
esto encendido : verum;
esto apagado : falsus;

## Sin valor inicial ##
esto sinValor : numerus;
esto otroSinValor : textum;

## Valor calculado a partir de otra variable ##
esto doble : numerus entero * 2;
esto concatenado : textum texto + " version 1";

## Conversion implicita hacia arriba en la jerarquia ##
esto ensanchado : decimalis entero;
esto desdeLetra : numerus letra;

MAIOR>
>> "Entero: " >> entero;
>> "Decimal: " >> decimal;
>> "Concatenado: " >> concatenado;
>> "Activo: " >> activo;
FINIS;
