##
    Errores esperados: SEMANTICOS de declaracion y ambito
##
VARIABILES>
esto repetida : numerus 1;
esto repetida : numerus 2;
esto otra : numerus 3;
esto otra : textum "choque de tipos";

MUNERA>
ratio numerus funcionRepetida() {
    reddere 1;
} finis;

ratio numerus funcionRepetida() {
    reddere 2;
} finis;

## Una funcion no puede llamarse igual que una variable global ##
ratio numerus otra() {
    reddere 3;
} finis;

MAIOR>

## Variable no declarada ##
>> noExiste;
noExiste = 5;

## Declaracion fuera de la seccion VARIABILES ##
esto fueraDeSeccion : numerus 10;
series arregloFuera[2] : numerus {1, 2};

## Declaracion dentro de un bloque de control ##
si (repetida > 0) {
    esto dentroDelSi : numerus 1;
} finis;

## Estructura definida fuera de la seccion VARIABILES ##
structura FueraDeLugar {
    esto campo : numerus
} finis;

## Usar una funcion como si fuera variable ##
>> funcionRepetida;

## Usar una variable como si fuera funcion ##
>> repetida();

FINIS;
