##
    Prueba: arreglos en todas sus formas
##
VARIABILES>

## Tipado con valores iniciales ##
series enteros[3] : numerus {1, 2, 3};
series textos[2] : textum {"Hola", "Adios"};
series letras[2] : littera {'a', 'b'};
series decimales[2] : decimalis {1.5, 2.5};

## Tipado sin valores iniciales ##
series vacio[5] : numerus;
series vacioTexto[3] : textum;

## Booleano tipado ##
series banderas[2] : bool {verum, falsus};

## Tipo inferido de la lista, confirmado en el foro ##
series inferido[2] : {verum, verum};

## Menos valores que la dimension declarada, es valido ##
series parcial[5] : numerus {1, 2};

esto indice : numerus 1;

## Operacion entre elementos de un arreglo ##
esto suma : numerus enteros[0] + enteros[1];

MAIOR>

## Lectura por indice constante y por variable ##
>> "Primero: " >> enteros[0];
>> "Por variable: " >> enteros[indice];

## Escritura por indice ##
enteros[2] = 99;
textos[0] = "Modificado";
banderas[1] = verum;

>> "Suma: " >> suma;
FINIS;
