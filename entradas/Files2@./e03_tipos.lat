##
    Errores esperados: SEMANTICOS de tipos
    Todas las declaraciones van en VARIABILES para que el unico
    error de cada linea sea el de tipos
##
VARIABILES>
esto entero : numerus 10;
esto texto : textum "hola";
esto bandera : bool verum;
esto decimal : decimalis 1.5;

## textum solo admite concatenacion, no otras operaciones ##
esto malo1 : numerus texto * 2;
esto malo2 : numerus texto - 1;
esto malo3 : numerus texto / 2;

## Los operadores logicos exigen booleano estricto ##
esto malo4 : bool entero && bandera;
esto malo5 : bool texto || bandera;

## La negacion exige booleano ##
esto malo6 : bool non entero;

## Comparacion de orden entre tipos no ordenables ##
esto malo7 : bool bandera > entero;

## Estrechamiento: perder decimales no es implicito ##
esto malo8 : numerus decimal;

MAIOR>

## Condicion que no es booleana ##
si (entero) {
    >> "no deberia compilar";
} finis;

dum (texto) {
    >> "tampoco";
} finis;

FINIS;
