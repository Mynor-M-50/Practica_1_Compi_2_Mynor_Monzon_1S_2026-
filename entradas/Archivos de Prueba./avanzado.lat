## ================================================================
   11. EXPRESIONES CON PRECEDENCIA COMPLEJA
   Verificar en el AST que el anidamiento respeta la precedencia:
       or < and < igualdad < relacional < suma < multiplicacion
   ================================================================ ##
>> "=== PRECEDENCIA ===";

## Se debe leer como  ((2*3) + (4*5)) - (6/2)  ##
temporal = 2 * 3 + 4 * 5 - 6 / 2;
>> "Aritmetica mezclada: " >> temporal;

## Los parentesis cambian el orden ##
temporal = 2 * (3 + 4) * (5 - 6) / 2;
>> "Con parentesis: " >> temporal;

## Se debe leer como  ((a>b) && (c<d)) || (non e)  ##
ordenado = temporal > 0 && aprobados < 10 || non ordenado;
>> "Logica mezclada: " >> ordenado;

## Negacion sobre una comparacion agrupada ##
ordenado = non (temporal > 0 && aprobados > 0);
>> "Negacion agrupada: " >> ordenado;

## Menos unario dentro de una expresion mayor ##
temporal = -temporal + 10 * -2;
>> "Unarios: " >> temporal;

## Concatenacion encadenada con numeros ##
reporte = "Total: " + temporal + " unidades";
>> reporte;

## ================================================================
   12. LECTURA EN DESTINOS COMPLEJOS
   << debe aceptar cualquier destino asignable.
   ================================================================ ##
>> "=== LECTURA ===";

temporal <<
datos[0] <<
alumnos[0].nombre <<
matriz.filas[0].celdas[0] <<
arbol.izq.izq.valor <<

>> "Fin del archivo avanzado";

FINIS;
